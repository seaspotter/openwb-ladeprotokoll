# Copy to .env and adjust. docker-compose reads this automatically.
#
# Everything about a specific openWB installation (its address, vehicles,
# electricity prices) is configured from the web UI after first start, not
# here. These are pure infra wiring: the database, the web port, and the
# container's clock.

POSTGRES_PASSWORD=change_me
PORT=8080

# Defaults to Europe/Berlin (see docker-compose.yml). Report timestamps
# (generation date, footer) use the container's own clock, so this matters
# for those even though a session's own Beginn/Ende come straight from
# openWB and are unaffected either way. Uncomment only if Berlin isn't your
# zone.
#TZ=America/New_York
